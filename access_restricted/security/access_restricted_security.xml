<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_allow_add_implied_from_settings" model="res.groups">
        <field name="name">Allow add implied groups from settings</field>
    </record>
    <record id="not_admin_tenant_rule" model="ir.access">
        <field name="name">Only admin can edit admin</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="operation">cud</field>
        <field name="domain">[('id', '!=', 1)]</field>
        <field name="protected" eval="True"/>
    </record>
    <record id="res_groups_restricted" model="ir.access">
        <field name="name">Restrict changes to groups</field>
        <field name="model_id" ref="base.model_res_groups"/>
        <field name="domain"
               eval="&quot;['|', ('id', 'in', user.all_group_ids.ids), ('id', '=', '%s')]&quot; % ref('base.group_no_one')"/>
        <field name="operation">ud</field>
        <field name="protected" eval="True"/>
    </record>
</odoo>
