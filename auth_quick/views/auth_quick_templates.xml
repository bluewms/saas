<odoo>
    <template id="confirm_login" name="Confirm tenant login">
        <t t-call="web.login_layout">
            <form action="/auth_quick/check-token" method="post" class="text-center">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <button type="submit" class="btn btn-primary">Continue to this database</button>
            </form>
        </t>
    </template>
</odoo>
