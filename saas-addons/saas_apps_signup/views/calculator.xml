<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="price" inherit_id="saas_apps.price">
        <xpath expr="//button[@id='try-trial']" position="replace">
            <button id="try-trial2" type="button" class="btn btn-lg btn-block btn-primary fnt-larger">
                First month free <span class="ms-1 fw-bold">0 <t t-out="currency.symbol"/></span>
            </button>
            <p class="small text-muted mt-2">Subscription prices apply after the free month. Choose your subdomain and verify your email to open your workspace.</p>
        </xpath>
    </template>
</odoo>
